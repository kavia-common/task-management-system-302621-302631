# Backend (Express) environment variables
# NOTE: Do NOT commit real secrets to git; provide via deployment environment.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# For backend: use a key that can read/write to tables (service role recommended server-side only)
NEXT_PUBLIC_SUPABASE_KEY=your_supabase_service_role_key

# CORS / URLs
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Backend JWT signing (required)
JWT_SECRET=replace_me_with_strong_secret
JWT_EXPIRES_IN=7d

# Optional: cookie-based auth support (SPA bearer-token works without this)
AUTH_USE_COOKIE=false
AUTH_COOKIE_NAME=tm_session

# Server
NEXT_PUBLIC_PORT=3001
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_TRUST_PROXY=true
